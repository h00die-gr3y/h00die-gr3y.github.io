---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';

const categoryOrder = [
  'web-applications',
  'exploit-development',
  'infrastructure',
  'iot-embedded',
  'tools-techniques',
];
const categoryLabels = {
  'web-applications': 'Web Applications',
  'exploit-development': 'Exploit Development',
  'infrastructure': 'Infrastructure',
  'iot-embedded': 'IoT & Embedded',
  'tools-techniques': 'Tools & Techniques',
};
const entries = (await getCollection('knowledgeBase'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const groups = categoryOrder
  .map((category) => ({ category, entries: entries.filter((entry) => entry.data.category === category) }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout title="Knowledge Base — h00die-gr3y" description="Reusable security research notes, techniques and practical reference material.">
  <Header />
  <main id="main-content" tabindex="-1">
    <section class="page-hero kb-index-hero">
      <div class="container narrow">
        <span class="section-index">RESEARCH / REFERENCE</span>
        <h1>Knowledge Base</h1>
        <p>Reusable technical notes, methodology and reference material extracted from practical vulnerability research and exploit development.</p>
      </div>
    </section>

    <section class="section section-bordered kb-index-section">
      <div class="container">
        <div class="kb-index-heading">
          <div>
            <span class="section-index">REFERENCE LIBRARY</span>
            <h2>Browse by area</h2>
          </div>
          <div class="kb-count">{entries.length} {entries.length === 1 ? 'ENTRY' : 'ENTRIES'}</div>
        </div>

        {groups.map((group) => (
          <section class="kb-group" aria-labelledby={`kb-${group.category}`}>
            <div class="kb-group-heading">
              <h2 id={`kb-${group.category}`}>{categoryLabels[group.category]}</h2>
              <span>{group.entries.length.toString().padStart(2, '0')}</span>
            </div>
            <div class="kb-grid">
              {group.entries.map((entry) => (
                <KnowledgeCard
                  title={entry.data.title}
                  description={entry.data.description}
                  category={entry.data.category}
                  topics={entry.data.topics}
                  href={`/knowledge-base/${entry.id}/`}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
