  <Header />
  <main id="main-content" tabindex="-1">
    <section class="page-hero">
      <div class="container narrow">
        <span class="section-index">LEGAL / RESPONSIBLE USE</span>
        <h1>Disclaimer</h1>
        <p>Responsible-use and disclosure information for the technical research published on this site.</p>
      </div>
    </section>
    <section class="section section-bordered">
      <div class="container narrow prose-shell">
        <h2>Disclaimer</h2>
        <p>The technical material published here is intended for security research, education, defensive testing and responsible vulnerability disclosure.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
