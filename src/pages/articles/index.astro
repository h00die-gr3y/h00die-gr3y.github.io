---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = (await getCollection('articles'))
  .filter((article) => article.data.status === 'published')
  .sort((a, b) => b.data.published.localeCompare(a.data.published));
---

<BaseLayout title="Articles — h00die-gr3y" description="Long-form technical articles connecting vulnerability research, exploitation and security engineering practice.">
  <Header />
  <main id="main-content" tabindex="-1">
    <section class="page-hero article-index-hero">
      <div class="container narrow">
        <span class="section-index">RESEARCH / LONG-FORM</span>
        <h1>Articles</h1>
        <p>Long-form technical writing that connects methods, techniques and lessons across individual vulnerabilities, exploit-development projects and research areas.</p>
      </div>
    </section>

    <section class="section section-bordered article-index-section">
      <div class="container">
        <div class="article-index-heading">
          <div>
            <span class="section-index">PUBLISHED</span>
            <h2>Technical articles</h2>
          </div>
          <div class="article-count">{articles.length} {articles.length === 1 ? 'ARTICLE' : 'ARTICLES'}</div>
        </div>

        {articles.length > 0 ? (
          <div class="article-list">
            {articles.map((article, index) => (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                published={article.data.published}
                topics={article.data.topics}
                href={`/articles/${article.id}/`}
                featured={index === 0 && article.data.featured}
              />
            ))}
          </div>
        ) : (
          <div class="article-empty">No published articles yet.</div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
