---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  socialImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  schemaType?: 'WebPage' | 'WebSite' | 'ProfilePage' | 'Article' | 'TechArticle';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  redirectTo?: string;
}

const {
  title = 'h00die-gr3y — Security Research',
  description = 'Independent security research, vulnerability analysis and exploit development.',
  canonicalPath,
  robots = 'index,follow',
  socialImage = '/images/site/h00die-gr3y-social.png',
  ogType = 'website',
  schemaType,
  publishedTime,
  modifiedTime,
  keywords = [],
  redirectTo,
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://h00die-gr3y.github.io');
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteBase).toString();
const socialImageUrl = new URL(socialImage, siteBase).toString();
const redirectUrl = redirectTo ? new URL(redirectTo, siteBase).toString() : null;
const currentPath = Astro.url.pathname;

const researcher = {
  '@type': 'Person',
  name: 'h00die-gr3y',
  url: new URL('/about/', siteBase).toString(),
  sameAs: ['https://github.com/h00die-gr3y'],
  knowsAbout: [
    'Vulnerability research',
    'Exploit development',
    'Application security',
    'Network appliances',
    'IoT and embedded security',
  ],
};

const resolvedSchemaType = schemaType ?? (currentPath === '/' ? 'WebSite' : 'WebPage');
let structuredData: Record<string, unknown>;

if (resolvedSchemaType === 'ProfilePage') {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: title,
    description,
    url: canonicalUrl,
    mainEntity: researcher,
  };
} else if (resolvedSchemaType === 'Article' || resolvedSchemaType === 'TechArticle') {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': resolvedSchemaType,
    headline: title.replace(/ — Knowledge Base — h00die-gr3y$/, '').replace(/ — h00die-gr3y$/, ''),
    description,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    image: socialImageUrl,
    author: researcher,
    publisher: researcher,
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
  };
} else if (resolvedSchemaType === 'WebSite') {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'h00die-gr3y',
    description,
    url: canonicalUrl,
    author: researcher,
  };
} else {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: 'h00die-gr3y',
      url: new URL('/', siteBase).toString(),
    },
  };
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="h00die-gr3y" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#090c0b" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/images/site/favicon.png" />
    <link rel="apple-touch-icon" href="/images/site/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="h00die-gr3y Research Feed" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="me" href="https://github.com/h00die-gr3y" />

    <meta property="og:site_name" content="h00die-gr3y" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType === 'profile' ? 'profile' : ogType} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="h00die-gr3y security research" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}

    {redirectUrl && <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
